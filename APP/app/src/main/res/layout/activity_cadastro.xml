<?xml version="1.0" encoding="utf-8"?>
<!--
    Tela de Cadastro de Cliente do app Doces Yncantos.
    Segue a identidade visual da tela de login com ScrollView,
    campos estilizados com cantos arredondados e botão reativo.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_cream"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/login_padding_tela"
        android:paddingEnd="@dimen/login_padding_tela"
        android:paddingTop="32dp"
        android:paddingBottom="@dimen/login_espaco_secao">

        <!-- Logo centralizada -->
        <ImageView
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@string/cadastro_titulo"
            android:src="@drawable/logo_doces_yncantos" />

        <!-- Subtítulo -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/cadastro_subtitulo"
            android:textColor="@color/gray_text"
            android:textSize="@dimen/login_texto_subtitulo" />

        <!-- Campo: Nome e Sobrenome -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/cadastro_label_nome"
            android:textColor="@color/gray_text"
            android:textSize="@dimen/login_texto_label" />

        <EditText
            android:id="@+id/edtNome"
            android:layout_width="match_parent"
            android:layout_height="@dimen/login_altura_campo"
            android:layout_marginTop="@dimen/login_espaco_label_campo"
            android:background="@drawable/bg_campo_texto"
            android:inputType="textPersonName|textCapWords"
            android:paddingStart="@dimen/login_padding_campo_horizontal"
            android:paddingEnd="@dimen/login_padding_campo_horizontal"
            android:singleLine="true"
            android:textColor="@color/text_brown"
            android:textSize="@dimen/login_texto_campo" />

        <!-- Campo: E-mail -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/login_label_email"
            android:textColor="@color/gray_text"
            android:textSize="@dimen/login_texto_label" />

        <EditText
            android:id="@+id/edtEmail"
            android:layout_width="match_parent"
            android:layout_height="@dimen/login_altura_campo"
            android:layout_marginTop="@dimen/login_espaco_label_campo"
            android:background="@drawable/bg_campo_texto"
            android:inputType="textEmailAddress"
            android:paddingStart="@dimen/login_padding_campo_horizontal"
            android:paddingEnd="@dimen/login_padding_campo_horizontal"
            android:singleLine="true"
            android:textColor="@color/text_brown"
            android:textSize="@dimen/login_texto_campo" />

        <!-- Campo: Telefone / WhatsApp -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/cadastro_label_telefone"
            android:textColor="@color/gray_text"
            android:textSize="@dimen/login_texto_label" />

        <EditText
            android:id="@+id/edtTelefone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/login_altura_campo"
            android:layout_marginTop="@dimen/login_espaco_label_campo"
            android:background="@drawable/bg_campo_texto"
            android:hint="(99) 99999-9999"
            android:textColorHint="@color/gray_text"
            android:inputType="phone"
            android:paddingStart="@dimen/login_padding_campo_horizontal"
            android:paddingEnd="@dimen/login_padding_campo_horizontal"
            android:singleLine="true"
            android:textColor="@color/text_brown"
            android:textSize="@dimen/login_texto_campo" />

        <!-- Campo: Senha -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/login_label_senha"
            android:textColor="@color/gray_text"
            android:textSize="@dimen/login_texto_label" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/login_altura_campo"
            android:layout_marginTop="@dimen/login_espaco_label_campo">

            <EditText
                android:id="@+id/edtSenha"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_campo_texto"
                android:inputType="textPassword"
                android:paddingStart="@dimen/login_padding_campo_horizontal"
                android:paddingEnd="44dp"
                android:singleLine="true"
                android:textColor="@color/text_brown"
                android:textSize="@dimen/login_texto_campo" />

            <ImageView
                android:id="@+id/imgAlternarSenha"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="@dimen/login_padding_campo_horizontal"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/login_alternar_visibilidade_senha"
                android:focusable="true"
                android:src="@drawable/ic_olho_aberto" />

        </FrameLayout>

        <!-- Campo: Confirmar senha -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/cadastro_label_confirmar_senha"
            android:textColor="@color/gray_text"
            android:textSize="@dimen/login_texto_label" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/login_altura_campo"
            android:layout_marginTop="@dimen/login_espaco_label_campo">

            <EditText
                android:id="@+id/edtConfirmarSenha"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_campo_texto"
                android:inputType="textPassword"
                android:paddingStart="@dimen/login_padding_campo_horizontal"
                android:paddingEnd="44dp"
                android:singleLine="true"
                android:textColor="@color/text_brown"
                android:textSize="@dimen/login_texto_campo" />

            <ImageView
                android:id="@+id/imgAlternarConfirmarSenha"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="@dimen/login_padding_campo_horizontal"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/login_alternar_visibilidade_senha"
                android:focusable="true"
                android:src="@drawable/ic_olho_aberto" />

        </FrameLayout>

        <!-- Mensagem de erro visual (ex: senhas não coincidem ou erro da API) -->
        <TextView
            android:id="@+id/txtMensagemErro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textColor="#D32F2F"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Botão principal "Criar conta" -->
        <TextView
            android:id="@+id/btnCriarConta"
            android:layout_width="match_parent"
            android:layout_height="@dimen/login_altura_botao_entrar"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_botao_entrar_desabilitado"
            android:clickable="true"
            android:enabled="false"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/cadastro_botao_criar"
            android:textColor="@color/white"
            android:textSize="@dimen/login_texto_botao_entrar"
            android:textStyle="bold" />

        <!-- Link "Já tem conta? Entrar" -->
        <LinearLayout
            android:id="@+id/linhaEntrar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cadastro_ja_tem_conta"
                android:textColor="@color/pink_primary"
                android:textSize="@dimen/login_texto_rodape" />

            <TextView
                android:id="@+id/txtEntrar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/cadastro_entrar"
                android:textColor="@color/pink_dark"
                android:textSize="@dimen/login_texto_rodape"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
